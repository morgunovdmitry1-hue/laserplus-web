---
/**
 * FAQPage-разметка, собранная из markdown-тела страницы.
 *
 * Ожидаемый формат в контенте:
 *   ## Частые вопросы
 *   **Вопрос?**
 *   Ответ.            (или через пустую строку — оба варианта работают)
 *
 * Разметка выводится только если вопросов хотя бы два: на одном
 * FAQPage не имеет смысла, а пустой блок — лишний шум в выдаче.
 */
interface Props {
  /** Сырое markdown-тело страницы */
  body: string;
}

const { body } = Astro.props;

/** Убирает markdown-разметку из строки, чтобы в JSON-LD попал чистый текст. */
function toPlainText(md: string): string {
  return md
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // ссылки → текст
    .replace(/\*\*([^*]+)\*\*/g, '$1') // жирный
    .replace(/[*_`]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

interface QA {
  question: string;
  answer: string;
}

function parseFaq(source: string): QA[] {
  const section = source.split(/^##\s+Частые вопросы\s*$/m)[1];
  if (!section) return [];

  // Обрезаем по следующему заголовку того же уровня, если он есть.
  const scope = section.split(/^##\s+/m)[0];

  // Режем по строкам, целиком состоящим из **…**: это вопросы, всё между ними — ответ.
  // Через split, а не exec с lookahead на конец строки: в JS нет \z, и последний
  // вопрос при таком подходе терялся.
  const parts = scope.split(/^\*\*(.+?)\*\*\s*$/gm);
  const items: QA[] = [];
  // parts[0] — текст до первого вопроса, дальше идут пары «вопрос, ответ».
  for (let i = 1; i < parts.length; i += 2) {
    const question = toPlainText(parts[i]);
    const answer = toPlainText(parts[i + 1] ?? '');
    if (question && answer) items.push({ question, answer });
  }
  return items;
}

const faq = parseFaq(body);

const schema =
  faq.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map(({ question, answer }) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
      }
    : null;
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
