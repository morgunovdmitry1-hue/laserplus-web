---
import { SITE } from '../../consts';

interface Props {
  title: string;
  slug: string;
  description: string;
  price: { single: number; course6?: number; course8?: number };
  clinicIds: string[];
  rating?: { value: number; count: number };
}

const { title, slug, description, price, clinicIds, rating } = Astro.props;

// В разметке для поисковиков отдаём те же цены, что видит клиент на странице,
// то есть по скидочной карте (−40%). Иначе цена в выдаче разойдётся с ценой на сайте.
const cardPrice = (p: number) => Math.round((p * 0.6) / 10) * 10;

const offers = [
  {
    '@type': 'Offer',
    name: 'Разовая процедура',
    price: cardPrice(price.single),
    priceCurrency: 'RUB',
    availability: 'https://schema.org/InStock',
  },
  ...(price.course6
    ? [
        {
          '@type': 'Offer',
          name: 'Курс 6 процедур',
          price: cardPrice(price.course6),
          priceCurrency: 'RUB',
          availability: 'https://schema.org/InStock',
        },
      ]
    : []),
  ...(price.course8
    ? [
        {
          '@type': 'Offer',
          name: 'Курс 8 процедур',
          price: cardPrice(price.course8),
          priceCurrency: 'RUB',
          availability: 'https://schema.org/InStock',
        },
      ]
    : []),
];

const schema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalProcedure', 'Service'],
  '@id': `${SITE.url}/services/${slug}/#procedure`,
  name: title,
  description,
  url: `${SITE.url}/services/${slug}/`,
  provider: clinicIds.map((id) => ({
    '@id': `${SITE.url}/contacts/${id}/#localbusiness`,
  })),
  offers,
  ...(rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: rating.value,
          reviewCount: rating.count,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
