---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaBreadcrumbs from '../../components/seo/SchemaBreadcrumbs.astro';
import { zoneName } from '../../data/zoneNames';

const allServices = await getCollection('services');

// На сайте показываем цены по скидочной карте (−40% от базовой), как в прайсе
const cardPrice = (p: number) => Math.round((p * 0.6) / 10) * 10;
const alexPrice = (s: (typeof allServices)[number]) =>
  s.data.technologies.includes('alexandrite') ? cardPrice(s.data.price.single) : null;
const diodePrice = (s: (typeof allServices)[number]) =>
  s.data.technologies.includes('diode')
    ? cardPrice(s.data.price.diode ?? s.data.price.single)
    : null;
const minPrice = (s: (typeof allServices)[number]) =>
  Math.min(...[alexPrice(s), diodePrice(s)].filter((x): x is number => x !== null));

// Популярные зоны — то, что ищут чаще всего: карточками сверху и первыми строками в таблице
const popularIds = [
  'podmyshki',
  'bikini-klassika',
  'glubokoye-bikini',
  'totalnoe-bikini',
  'goleni',
  'nogi-polnostyu',
];
const popular = popularIds
  .map((id) => allServices.find((s) => s.id === id))
  .filter((s): s is (typeof allServices)[number] => Boolean(s));
// У мужчин свои частые зоны
const menFirst = ['men-spina', 'men-grud', 'men-boroda', 'men-podmyshki', 'men-plechi', 'men-nogi'];

const categoryOrder = ['basic', 'intimate', 'face', 'premium'];
const rank = (id: string, first: string[]) =>
  first.includes(id) ? first.indexOf(id) : first.length;
const byGender = (gender: 'female' | 'male') => {
  const first = gender === 'female' ? popularIds : menFirst;
  return allServices
    .filter((s) => s.data.gender !== (gender === 'female' ? 'male' : 'female'))
    .sort(
      (a, b) =>
        rank(a.id, first) - rank(b.id, first) ||
        categoryOrder.indexOf(a.data.category) - categoryOrder.indexOf(b.data.category) ||
        a.data.price.single - b.data.price.single
    );
};

const tabs = [
  { id: 'women', label: 'Женщинам', services: byGender('female') },
  { id: 'men', label: 'Мужчинам', services: byGender('male') },
];

const rub = (n: number) => `${n.toLocaleString('ru-RU')} ₽`;
---

<BaseLayout
  title="Услуги и цены лазерной эпиляции в Новосибирске"
  description="Все зоны лазерной эпиляции для женщин и мужчин в Новосибирске: цены на диодном и александритовом лазере по скидочной карте, количество процедур. Запись онлайн."
>
  <div class="container">
    <SchemaBreadcrumbs items={[{ name: 'Услуги', href: '/services/' }]} />
  </div>

  <section class="services-page">
    <div class="container">
      <div class="page-header">
        <h1 data-reveal>Лазерная эпиляция в Новосибирске: все зоны и цены</h1>
        <p data-reveal data-reveal-delay="1">
          Диодный лазер In-Motion D1 — на обоих филиалах. Александритовые Candela GentlePro — на
          Красном проспекте, DEKA Motus AX Moveo — на Октябрьской. Цены указаны по скидочной карте.
        </p>
      </div>

      <!-- Популярные зоны -->
      <h2 class="popular-title" data-reveal>Популярные зоны</h2>
      <div class="popular-grid" data-reveal data-reveal-delay="1">
        {
          popular.map((s) => (
            <a href={`/services/${s.id}/`} class="popular-card">
              <span class="pc-name">{zoneName(s.id, s.data.title)}</span>
              <span class="pc-price">от {rub(minPrice(s))}</span>
              <span class="pc-meta">{s.data.sessionsRequired} процедур</span>
            </a>
          ))
        }
        <a href="/men/" class="popular-card popular-card--men">
          <span class="pc-name">Мужчинам</span>
          <span class="pc-meta">спина, грудь, борода и другие зоны</span>
        </a>
      </div>

      <!-- Вкладки: женщинам / мужчинам -->
      <div class="services-tabs" role="tablist" aria-label="Для кого" data-reveal>
        {
          tabs.map((tab, i) => (
            <button
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
              class:list={['stab', { 'stab--active': i === 0 }]}
            >
              <span class="stab-main">{tab.label}</span>
            </button>
          ))
        }
      </div>

      {
        tabs.map((tab, i) => (
          <div
            id={`panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${tab.id}`}
            hidden={i !== 0 ? true : undefined}
          >
            <div class="services-list">
              <div class="list-header">
                <span class="lh-name">Зона</span>
                <span class="lh-price">Диод</span>
                <span class="lh-price">
                  <span class="lh-full">Александрит</span>
                  <span class="lh-short">Алекс.</span>
                </span>
                <span class="lh-gap" />
              </div>
              {tab.services.map((service) => {
                const d = diodePrice(service);
                const a = alexPrice(service);
                return (
                  <a href={`/services/${service.id}/`} class="service-row">
                    <span class="sr-name">{zoneName(service.id, service.data.title)}</span>
                    <span class="sr-price">{d === null ? '—' : rub(d)}</span>
                    <span class="sr-price sr-price--alex">{a === null ? '—' : rub(a)}</span>
                    <span class="sr-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
      <p class="price-note">
        Цены по скидочной карте — это −40% от базовой цены. Точное число процедур и подходящий лазер
        подскажет специалист на бесплатной консультации.
      </p>

      <!-- CTA после прайса -->
      <div class="services-cta" data-reveal>
        <div class="services-cta-text">
          <p class="services-cta-label">Скидка 40% на первый визит</p>
          <p class="services-cta-sub">Запись займёт 2 минуты — без звонков и предоплаты</p>
        </div>
        <div class="services-cta-actions">
          <a href="/booking/" class="scta-btn-primary">Записаться онлайн</a>
          <a href="tel:+79139177677" class="scta-btn-ghost">Позвонить</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('aria-controls');
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('stab--active');
      });
      panels.forEach((p) => p.setAttribute('hidden', ''));
      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('stab--active');
      document.getElementById(target ?? '')?.removeAttribute('hidden');
    });
  });
</script>

<style>
  .services-page {
    padding: 1rem 0 5rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }
  .page-header h1 {
    margin: 0 0 0.75rem;
  }
  .page-header p {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 600px;
  }

  /* ── Tabs ── */
  /* ── Популярные зоны ── */
  .popular-title {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .popular-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .popular-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }
  .popular-card:hover {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 4%, white);
  }
  .pc-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }
  .pc-price {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .pc-meta {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .popular-card--men {
    justify-content: center;
    background: var(--color-bg-soft);
  }

  .services-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
    margin-bottom: 1.25rem;
    max-width: 420px;
  }

  .stab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.875rem 1.125rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: 100px;
    cursor: pointer;
    text-align: left;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .stab:hover {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 4%, white);
  }
  .stab--active {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, white);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
  .stab-main {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1;
  }
  .stab--active .stab-main {
    color: var(--color-primary);
  }

  /* ── Service list ── */
  .services-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ── Header & rows — одна строка как в прайсе ── */
  .list-header,
  .service-row {
    display: grid;
    grid-template-columns: 1fr 100px 110px 28px;
    align-items: center;
    gap: 0;
    padding: 0.625rem 1.25rem;
  }

  .list-header {
    background: var(--color-bg-soft);
    border-bottom: 2px solid var(--color-border);
  }
  .lh-name,
  .lh-price,
  .lh-gap {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
  }
  .lh-price {
    text-align: right;
  }
  .lh-short {
    display: none;
  }

  .service-row {
    background: var(--color-bg);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-fast);
    padding: 0.875rem 1.25rem;
  }
  .service-row:last-child {
    border-bottom: none;
  }
  .service-row:hover {
    background: var(--color-bg-soft);
  }

  .sr-name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.35;
    padding-right: 1rem;
  }
  .sr-price {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: right;
    white-space: nowrap;
  }
  .sr-price--alex {
    color: var(--color-primary);
  }
  .sr-arrow {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: right;
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }
  .service-row:hover .sr-arrow {
    transform: translateX(3px);
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    .list-header,
    .service-row {
      grid-template-columns: 1fr 64px 76px 16px;
      column-gap: 0.5rem;
      padding: 0.75rem 0.875rem;
    }
    .lh-full {
      display: none;
    }
    .lh-short {
      display: inline;
    }
    .sr-name {
      font-size: 0.875rem;
    }

    .sr-price {
      font-size: 0.8125rem;
    }
  }

  .price-note {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 640px;
  }

  /* ── CTA после прайса ── */
  .services-cta {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    background: linear-gradient(130deg, #4a9ab5 0%, #64b0c7 50%, #a8d8e8 100%);
    border-radius: var(--radius-xl);
    padding: 2rem 2.5rem;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .services-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .services-cta::before {
    content: '';
    position: absolute;
    right: -40px;
    top: -40px;
    width: 220px;
    height: 220px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    pointer-events: none;
  }
  .services-cta-label {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.375rem;
    letter-spacing: -0.01em;
  }
  .services-cta-sub {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    line-height: 1.5;
  }
  .services-cta-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .scta-btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: #fff;
    color: #2e7d96;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.9375rem;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .scta-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    color: #2e7d96;
  }
  .scta-btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.5rem;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    border-radius: 100px;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    text-decoration: none;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    transition: background var(--transition-fast);
  }
  .scta-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
</style>
