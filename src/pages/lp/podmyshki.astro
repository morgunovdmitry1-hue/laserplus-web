---
export const prerender = true;

import '../../styles/global.css';
import SchemaOrganization from '../../components/seo/SchemaOrganization.astro';
import YandexMetrika from '../../components/seo/YandexMetrika.astro';

const METRIKA_ID = '52399276';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>3 бесплатных сеанса лазерной эпиляции подмышек — Laser Plus, Новосибирск</title>
    <meta
      name="description"
      content="Получите 3 бесплатных сеанса лазерной эпиляции подмышек в клинике Laser Plus. Только для новых клиентов. Александритовый лазер Candela, медицинская лицензия."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="theme-color" content="#64B0C7" />
    <link rel="preload" as="image" href="/hero-main.webp" />
    <SchemaOrganization />
  </head>
  <body class="lp-body">
    <!-- Hero -->
    <section class="lp-hero">
      <img class="lp-hero-bg" src="/hero-main.webp" alt="" aria-hidden="true" />
      <div class="lp-hero-scrim"></div>

      <header class="lp-header">
        <div class="lp-container lp-header-inner">
          <a href="/" class="lp-logo" aria-label="Laser Plus — главная">
            <span class="lp-logo-text">Laser<span class="lp-logo-accent">Plus</span></span>
          </a>
          <div class="lp-header-badges">
            <span class="lp-header-badge">Медицинская лицензия</span>
            <span class="lp-header-badge lp-badge-extra">Номинант премии 2ГИС</span>
            <span class="lp-header-badge lp-badge-extra">Большой парк оборудования</span>
          </div>
        </div>
      </header>

      <div class="lp-container lp-hero-inner">
        <div class="lp-hero-copy">
          <div class="lp-new-badge">Только для новых клиентов</div>
          <h1 class="lp-h1">
            3 бесплатных сеанса<br />
            <span class="lp-h1-accent">лазерной эпиляции подмышек</span>
          </h1>
          <p class="lp-subtitle">
            Попробуйте лазерную эпиляцию на александритовом Candela GentlePro или диодном IN-MOTION
            D1. Оставьте заявку, администратор свяжется в течение 10 минут.
          </p>
        </div>

        <!-- Form -->
        <div class="lp-form-wrap" id="form">
          <form class="lp-form" id="leadForm" novalidate>
            <p class="lp-form-heading">Заберите свои 3 сеанса</p>
            <div class="lp-form-field">
              <label class="lp-label" for="name">Ваше имя</label>
              <input
                class="lp-input"
                type="text"
                id="name"
                name="name"
                placeholder="Екатерина"
                autocomplete="given-name"
                required
              />
            </div>
            <div class="lp-form-field">
              <label class="lp-label" for="phone">Номер телефона</label>
              <input
                class="lp-input"
                type="tel"
                id="phone"
                name="phone"
                placeholder="+7 (913) 000-00-00"
                autocomplete="tel"
                required
              />
            </div>
            <button class="lp-btn" type="submit" id="submitBtn">
              Получить 3 бесплатных сеанса
            </button>
            <p class="lp-form-note">
              Нажимая кнопку, вы соглашаетесь с
              <a href="/privacy/" target="_blank">политикой конфиденциальности</a>
            </p>
          </form>

          <!-- Success -->
          <div class="lp-success" id="successState" hidden>
            <div class="lp-success-icon">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="24" fill="#059669" fill-opacity="0.12"></circle>
                <path
                  d="M14 24l7 7 13-14"
                  stroke="#059669"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h2 class="lp-success-title">Заявка принята!</h2>
            <p class="lp-success-text">
              Администратор свяжется с вами в течение 10 минут и подберёт удобное время.
            </p>
          </div>

          <!-- Error -->
          <p class="lp-error" id="errorMsg" hidden>
            Что-то пошло не так. Позвоните нам: <a href="tel:+79139177677">+7 (913) 917-76-77</a>
          </p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="lp-steps">
      <div class="lp-container">
        <h2 class="lp-section-title">Как получить бесплатные сеансы</h2>
        <div class="lp-steps-grid">
          <div class="lp-step">
            <div class="lp-step-num">1</div>
            <h3 class="lp-step-title">Оставьте заявку</h3>
            <p class="lp-step-text">Укажите имя и телефон — форма выше</p>
          </div>
          <div class="lp-step">
            <div class="lp-step-num">2</div>
            <h3 class="lp-step-title">Администратор позвонит</h3>
            <p class="lp-step-text">Подберём удобное время в течение 10 минут</p>
          </div>
          <div class="lp-step">
            <div class="lp-step-num">3</div>
            <h3 class="lp-step-title">Приходите на процедуру</h3>
            <p class="lp-step-text">3 сеанса на подмышки — совершенно бесплатно</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="lp-trust">
      <div class="lp-container">
        <h2 class="lp-section-title">Почему Laser Plus</h2>
        <div class="lp-trust-grid">
          <div class="lp-trust-item">
            <div class="lp-trust-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <path
                  d="M14 3l2.8 5.7L23 9.7l-4.5 4.4 1.1 6.3L14 17.5l-5.6 2.9 1.1-6.3L5 9.7l6.2-.9L14 3z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3 class="lp-trust-title">Премиальные лазеры</h3>
            <p class="lp-trust-text">
              Александритовый Candela GentlePro — мировой стандарт для светлой кожи. Диодный
              IN-MOTION D1 — работает с любым фототипом и загаром.
            </p>
          </div>
          <div class="lp-trust-item">
            <div class="lp-trust-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <rect
                  x="4"
                  y="6"
                  width="20"
                  height="16"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.8"></rect>
                <path d="M4 11h20" stroke="currentColor" stroke-width="1.8"></path>
                <path
                  d="M9 16h4M9 19h6"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"></path>
              </svg>
            </div>
            <h3 class="lp-trust-title">Медицинская лицензия</h3>
            <p class="lp-trust-text">
              Клиника работает по лицензии Минздрава. Мастера с медицинским образованием и
              официальной сертификацией.
            </p>
          </div>
          <div class="lp-trust-item">
            <div class="lp-trust-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="1.8"></circle>
                <path
                  d="M14 8v6l4 2"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"></path>
              </svg>
            </div>
            <h3 class="lp-trust-title">8 лет на рынке</h3>
            <p class="lp-trust-text">
              Работаем с 2018 года. Тысячи клиентов прошли курс в Laser Plus. Высокий рейтинг на
              Яндекс.Картах и 2ГИС.
            </p>
          </div>
          <div class="lp-trust-item">
            <div class="lp-trust-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <path
                  d="M14 4C9.58 4 6 7.58 6 12c0 6 8 14 8 14s8-8 8-14c0-4.42-3.58-8-8-8z"
                  stroke="currentColor"
                  stroke-width="1.8"></path>
                <circle cx="14" cy="12" r="3" stroke="currentColor" stroke-width="1.8"></circle>
              </svg>
            </div>
            <h3 class="lp-trust-title">2 клиники в центре</h3>
            <p class="lp-trust-text">
              Красный проспект, 94 (м. Гагаринская, 1 мин.) и Сакко и Ванцетти, 25/1 (м.
              Октябрьская, 5 мин.).
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA repeat -->
    <section class="lp-cta">
      <div class="lp-container">
        <h2 class="lp-cta-title">Записаться на 3 бесплатных сеанса</h2>
        <p class="lp-cta-sub">
          Акция действует только для новых клиентов. Количество мест ограничено.
        </p>
        <a href="#form" class="lp-btn lp-btn--inline">Оставить заявку</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="lp-footer">
      <div class="lp-container">
        <p>© 2026 Laser Plus — сеть клиник лазерной эпиляции в Новосибирске</p>
        <p>
          <a href="tel:+79139177677">+7 (913) 917-76-77</a> &nbsp;·&nbsp;
          <a href="/privacy/">Политика конфиденциальности</a>
        </p>
      </div>
    </footer>

    <YandexMetrika id={METRIKA_ID} />

    <script>
      const form = document.getElementById('leadForm') as HTMLFormElement;
      const btn = document.getElementById('submitBtn') as HTMLButtonElement;
      const success = document.getElementById('successState') as HTMLElement;
      const errorMsg = document.getElementById('errorMsg') as HTMLElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Отправляем...';
        errorMsg.hidden = true;

        const data = {
          name: (document.getElementById('name') as HTMLInputElement).value,
          phone: (document.getElementById('phone') as HTMLInputElement).value,
          source: 'LP — 3 бесплатных сеанса подмышек',
        };

        try {
          const res = await fetch('https://laser-plus-app.vercel.app/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (res.ok) {
            form.hidden = true;
            success.hidden = false;
          } else {
            throw new Error('Server error');
          }
        } catch {
          errorMsg.hidden = false;
          btn.disabled = false;
          btn.textContent = 'Получить 3 бесплатных сеанса';
        }
      });
    </script>
  </body>
</html>

<style>
  .lp-body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-bg);
    -webkit-font-smoothing: antialiased;
  }

  .lp-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--container-padding-mobile);
  }

  /* ── Hero ── */
  .lp-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 5.5rem 0 3rem;
  }
  .lp-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }
  .lp-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(13, 35, 51, 0.72) 0%,
        rgba(13, 35, 51, 0.4) 30%,
        rgba(13, 35, 51, 0.4) 60%,
        rgba(13, 35, 51, 0.66) 100%
      ),
      linear-gradient(
        90deg,
        rgba(13, 35, 51, 0.5) 0%,
        rgba(13, 35, 51, 0.15) 55%,
        rgba(13, 35, 51, 0) 100%
      );
  }

  /* Header (over hero) */
  .lp-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 0;
    z-index: 3;
  }
  .lp-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .lp-logo {
    text-decoration: none;
  }
  .lp-logo-text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .lp-logo-accent {
    color: var(--color-primary);
  }
  .lp-header-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .lp-header-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 100px;
    padding: 0.25rem 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .lp-badge-extra {
    display: none;
  }
  @media (min-width: 880px) {
    .lp-badge-extra {
      display: inline-block;
    }
  }

  /* Hero inner: copy + form */
  .lp-hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  .lp-hero-copy {
    text-align: center;
  }
  .lp-new-badge {
    position: relative;
    display: inline-block;
    overflow: hidden;
    background: linear-gradient(
      100deg,
      var(--color-primary-dark) 0%,
      var(--color-primary) 38%,
      #9adcec 52%,
      var(--color-primary) 66%,
      var(--color-primary-dark) 100%
    );
    background-size: 220% 100%;
    animation: lp-flow 4s linear infinite;
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 100px;
    padding: 0.375rem 1rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 14px rgba(100, 176, 199, 0.45);
  }
  .lp-h1 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 5.5vw, 3rem);
    font-weight: 700;
    color: #fff;
    line-height: var(--leading-tight);
    margin: 0 0 1.25rem;
    text-shadow: 0 2px 20px rgba(13, 35, 51, 0.4);
  }
  .lp-h1-accent {
    color: #bfe3ee;
  }
  .lp-subtitle {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.9);
    line-height: var(--leading-normal);
    margin: 0 auto;
    max-width: 540px;
    text-shadow: 0 1px 12px rgba(13, 35, 51, 0.4);
  }

  /* Form */
  .lp-form-wrap {
    background: #fff;
    border-radius: var(--radius-2xl);
    padding: 1.75rem;
    max-width: 440px;
    width: 100%;
    margin: 0 auto;
    box-shadow: 0 24px 70px rgba(13, 35, 51, 0.35);
  }
  .lp-form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .lp-form-heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    margin: 0 0 0.25rem;
  }
  .lp-form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .lp-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }
  .lp-input {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text);
    transition: border-color 0.15s;
    outline: none;
    background: var(--color-bg);
  }
  .lp-input:focus {
    border-color: var(--color-primary);
  }
  .lp-btn {
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
    padding: 1rem;
    background: linear-gradient(
      100deg,
      var(--color-primary-dark) 0%,
      var(--color-primary) 40%,
      #8fd6e8 52%,
      var(--color-primary) 64%,
      var(--color-primary-dark) 100%
    );
    background-size: 220% 100%;
    animation: lp-flow 4.5s linear infinite;
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition:
      transform 0.1s,
      filter 0.15s,
      box-shadow 0.15s;
    margin-top: 0.25rem;
  }
  .lp-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -75%;
    width: 45%;
    height: 100%;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(255, 255, 255, 0.5) 50%,
      transparent 100%
    );
    transform: skewX(-20deg);
    animation: lp-shine 4.5s ease-in-out infinite;
    pointer-events: none;
  }
  .lp-btn:hover {
    filter: brightness(1.06);
    box-shadow: 0 8px 22px rgba(100, 176, 199, 0.45);
  }
  .lp-btn:active {
    transform: scale(0.98);
  }
  .lp-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  @keyframes lp-flow {
    0% {
      background-position: 220% 0;
    }
    100% {
      background-position: 0 0;
    }
  }
  @keyframes lp-shine {
    0% {
      left: -75%;
    }
    55% {
      left: 130%;
    }
    100% {
      left: 130%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-new-badge,
    .lp-btn {
      animation: none;
    }
    .lp-btn::after {
      display: none;
    }
  }
  .lp-form-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
  }
  .lp-form-note a {
    color: var(--color-text-muted);
  }

  /* Success / error */
  .lp-success {
    text-align: center;
    padding: 1rem 0;
  }
  .lp-success-icon {
    margin-bottom: 1rem;
  }
  .lp-success-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .lp-success-text {
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }
  .lp-error {
    font-size: var(--text-sm);
    color: var(--color-error);
    text-align: center;
    margin: 0.5rem 0 0;
  }
  .lp-error a {
    color: var(--color-error);
  }

  /* ── Sections (light & airy) ── */
  .lp-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    margin: 0 0 3rem;
  }

  .lp-steps {
    padding: 4.5rem 0;
    background: var(--color-bg);
  }
  .lp-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .lp-step {
    text-align: center;
  }
  .lp-step-num {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.125rem;
  }
  .lp-step-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }
  .lp-step-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .lp-trust {
    padding: 4.5rem 0;
    background: var(--color-bg-soft);
  }
  .lp-trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 560px) {
    .lp-trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .lp-trust-item {
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs);
  }
  .lp-trust-icon {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .lp-trust-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }
  .lp-trust-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }

  /* CTA */
  .lp-cta {
    background: var(--color-bg-tinted);
    padding: 4.5rem 0;
    text-align: center;
  }
  .lp-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .lp-cta-sub {
