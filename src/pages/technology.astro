---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaBreadcrumbs from '../components/seo/SchemaBreadcrumbs.astro';

const devices = [
  {
    id: 'candela',
    badge: 'Основная технология',
    name: 'Candela GentlePro',
    type: 'Александритовый лазер',
    wavelength: '755 нм',
    tagline: 'Топ премиум',
    location: 'Красный проспект, 94 (м. Гагаринская)',
    desc: [
      'Мы работаем на оригинальном лазере Candela (США) — это золотой стандарт в мире лазерной эпиляции. Не корейский аналог, не китайская копия — а оригинал, на котором обучают специалистов по всему миру.',
      'Ключевое отличие — система охлаждения. Мы используем медицинский фреон, который охлаждает кожу до −30°C прямо в момент вспышки. Именно это делает процедуру комфортной и безопасной.',
    ],
    indications: [
      'Светлая и смуглая кожа (фототипы I–IV)',
      'Светлые, тёмные и коричневые волосы',
      'Без загара (прошло более 2 недель)',
      'Все зоны тела и лица',
    ],
    advantages: [
      'Наивысшая эффективность даже на светлых волосах',
      'Минимальный дискомфорт благодаря охлаждению фреоном',
      'Быстрая обработка больших зон',
      'Доказанная клиническая эффективность',
    ],
    stats: [
      { value: '95%', label: 'нежелательных волосков убирает за один курс' },
      { value: '5–7', label: 'процедур стандартный курс' },
    ],
  },
  {
    id: 'motus',
    badge: 'Новое оборудование',
    name: 'DEKA Motus AX Moveo',
    type: 'Александритовый лазер',
    wavelength: '755 нм',
    tagline: 'Технология Moveo',
    location: 'Сакко и Ванцетти, 25/1 (м. Октябрьская)',
    desc: [
      'Александритовый лазер DEKA Motus AX (Италия) с фирменной технологией Moveo. Вместо отдельных импульсов по точкам мастер плавно скользит сапфировым наконечником по зоне, а аппарат подаёт частые мягкие импульсы плотностью 2–8 Дж/см².',
      'Кожа успевает остыть между импульсами, а фолликул накапливает тепло от прохода к проходу. За счёт этого лазер безопасно работает на любом фототипе — включая смуглую и загорелую кожу.',
    ],
    indications: [
      'Все фототипы кожи, от I до VI',
      'Смуглая и загорелая кожа',
      'Тонкие и слабопигментированные волосы',
      'Чувствительная кожа и низкий болевой порог',
    ],
    advantages: [
      'Загар: достаточно паузы в 1 день до и после',
      'Работает на смуглой коже — фототипы V–VI',
      'Скользящая обработка без резких щелчков',
      'Сапфировое охлаждение наконечника до 15 °C',
    ],
    stats: [
      { value: '1', label: 'день паузы по загару — самое мягкое правило' },
      { value: '6–7', label: 'процедур стандартный курс' },
    ],
  },
  {
    id: 'diode',
    badge: 'Дополнительная технология',
    name: 'In-Motion D1',
    type: 'Диодный лазер',
    wavelength: '810 нм',
    tagline: 'Проверенная классика',
    location: 'Оба филиала',
    desc: [
      'Диодный лазер IN-MOTION D1 — универсальный диодный лазер. Подходит для начала курса лазерной эпиляции. Технология скользящего импульса — движения по коже непрерывно, что позволяет работать со смуглой кожей и в период лёгкого загара.',
    ],
    indications: [
      'Смуглая и тёмная кожа (фототипы IV–VI)',
      'Период лёгкого загара',
      'Светлые, русые и тёмные волосы',
      'Чувствительная кожа',
    ],
    advantages: [
      'Работает с загорелой кожей',
      'Щадящий режим для чувствительных зон',
      'Подходит для тёмных фототипов',
      'Непрерывная система охлаждения',
    ],
    stats: [
      { value: '8–10', label: 'процедур стандартный курс' },
      { value: '1', label: 'заметный результат после первого сеанса' },
    ],
  },
];
---

<BaseLayout
  title="Оборудование для лазерной эпиляции: 3 лазера"
  description="Самый большой парк оборудования для лазерной эпиляции в Новосибирске: александритовые Candela GentlePro и DEKA Motus AX Moveo, диодный IN-MOTION D1. Сравнение, показания, эффективность."
>
  <div class="container">
    <SchemaBreadcrumbs items={[{ name: 'Оборудование', href: '/technology/' }]} />
  </div>

  <section class="tech-hero">
    <div class="container">
      <h1 data-reveal>Оборудование клиники: три лазера</h1>
      <p class="hero-desc" data-reveal data-reveal-delay="1">
        Один из самых больших парков оборудования для лазерной эпиляции в Новосибирске: два
        александритовых лазера — Candela GentlePro и DEKA Motus AX Moveo — и диодный IN-MOTION D1.
        Выбор аппарата зависит от Вашего типа кожи, цвета волос и степени загара.
      </p>
    </div>
  </section>

  <!-- Equipment cards -->
  <section class="tech-compare">
    <div class="container">
      <div class="compare-grid">
        {
          devices.map((d, i) => (
            <div class="eq-card" data-reveal data-reveal-delay={String(i + 1)}>
              {/* Photo zone */}
              <div class:list={['eq-photo', `eq-photo--${d.id}`]}>
                <div class="eq-photo-title">
                  <p class="eq-type">{d.type}</p>
                  <h2 class="eq-name">{d.name}</h2>
                  <p class="eq-wave">{d.tagline}</p>
                </div>
              </div>

              {/* Где стоит */}
              <p class="eq-location">
                <span class="eq-location-label">Где:</span> {d.location}
              </p>

              {/* Description */}
              <div class="eq-desc-wrap">
                {d.desc.map((para) => (
                  <p class="eq-desc">{para}</p>
                ))}
              </div>

              {/* Показания + Преимущества */}
              <div class="eq-sections">
                <div class="eq-section">
                  <h4>Показания</h4>
                  <ul>
                    {d.indications.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div class="eq-section">
                  <h4>Преимущества</h4>
                  <ul>
                    {d.advantages.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* Stats */}
              <div class="eq-stats">
                {d.stats.map((s) => (
                  <div class="eq-stat">
                    <strong>{s.value}</strong>
                    <span>{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="tech-how">
    <div class="container">
      <h2 data-reveal>Как работает лазерная эпиляция</h2>
      <div class="how-steps">
        {
          [
            {
              step: '01',
              title: 'Лазер находит волос',
              desc: 'Лазерный импульс «видит» тёмный пигмент в волосе, чем темнее волос, тем выше поглощение.',
            },
            {
              step: '02',
              title: 'Волос нагревается',
              desc: 'Энергия луча превращается в тепло прямо внутри волоска. Корень волоса прогревается.',
            },
            {
              step: '03',
              title: 'Корень перестаёт расти',
              desc: 'При таком нагреве клетки, из которых растёт волос, просто отключаются. Навсегда.',
            },
            {
              step: '04',
              title: 'Кожа остаётся целой',
              desc: 'Специальная система охлаждения защищает кожу во время процедуры. Затрагивается только сам волосяной корень — ничего лишнего.',
            },
          ].map(({ step, title, desc }, i) => (
            <div class="how-step" data-reveal data-reveal-delay={String(i + 1)}>
              <div class="step-number" aria-hidden="true">
                {step}
              </div>
              <div class="step-content">
                <h3>{title}</h3>
                <p>{desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="tech-faq">
    <div class="container">
      <h2 data-reveal>Частые вопросы об оборудовании</h2>
      <div class="faq-list" data-reveal data-reveal-delay="1">
        {
          [
            {
              q: 'Какой лазер подойдёт именно мне?',
              a: 'Специалист определяет технологию на консультации — по фототипу кожи, цвету волос и наличию загара. Для светлой кожи с тёмными волосами обычно выбирают александрит: Candela GentlePro на Красном проспекте или DEKA Motus AX на Октябрьской. Для смуглой кожи и в период загара — диодный IN-MOTION D1.',
            },
            {
              q: 'Больно ли делать лазерную эпиляцию?',
              a: 'Все три аппарата работают с охлаждением. Candela использует систему DCD с медицинским фреоном, DEKA Motus AX — скользящую технологию Moveo без резких щелчков, диодный IN-MOTION D1 — контактное сапфировое охлаждение. Большинство клиентов описывают ощущение как лёгкое пощипывание.',
            },
            {
              q: 'Чем отличаются Candela и DEKA Motus AX?',
              a: 'Оба — александритовые лазеры 755 нм, курс на обоих 6–7 процедур, цены одинаковые. Разница в способе обработки и в ограничениях. Candela работает отдельными импульсами с криогенным охлаждением, рассчитан на фототипы I–IV и требует 2 недели без загара. DEKA Motus AX использует скользящую технику Moveo, работает на всех фототипах включая смуглую кожу, а по загару достаточно паузы в один день. Candela стоит на Красном проспекте, DEKA — на Октябрьской.',
            },
            {
              q: 'Работает ли лазер на светлых волосах?',
              a: 'Александрит менее эффективен на очень светлых (русых, рыжих) и седых волосах: в них мало меланина. Диод справляется с русыми волосами лучше. Совсем белые волосы лазером не удаляются.',
            },
            {
              q: 'Сколько процедур нужно?',
              a: 'Стандартный курс — 6–8 процедур с интервалом 4–6 недель. Волосы растут циклично, лазер воздействует только на волосы в активной фазе роста (анаген).',
            },
          ].map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
      <a href="/faq/" class="link-faq">Все вопросы и ответы →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="tech-cta">
    <div class="container">
      <div class="cta-box">
        <div data-reveal>
          <h2>Запишитесь на бесплатную консультацию</h2>
          <p>Специалист подберёт оборудование и составит индивидуальный план курса процедур.</p>
        </div>
        <a href="/booking/" class="btn-primary" data-reveal data-reveal-delay="2"
          >Записаться онлайн</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tech-hero {
    padding: 2.5rem 0 3rem;
    background: var(--color-bg-soft);
    border-bottom: 1px solid var(--color-border);
  }
  .tech-hero h1 {
    margin: 0 0 1rem;
  }
  .hero-desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0;
    line-height: 1.65;
  }

  /* ── Equipment cards ── */
  .tech-compare {
    padding: 3.5rem 0;
  }
  .compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .eq-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  /* Блок статистики прижат к низу — карточки в ряду выглядят ровно
     независимо от длины описания. Раньше выравнивание держалось на subgrid,
     но он был жёстко завязан на две карточки. */
  .eq-stats {
    margin-top: auto;
  }

  @media (min-width: 1024px) {
    .compare-grid {
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.5rem;
      align-items: stretch;
    }
  }

  /* Photo zone — same proportions for both */
  .eq-photo {
    position: relative;
    height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem 2rem;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .eq-photo {
      height: 300px;
    }
  }

  .eq-photo--candela {
    background:
      linear-gradient(
        to top,
        rgba(13, 35, 51, 0.72) 0%,
        rgba(13, 35, 51, 0.1) 60%,
        transparent 100%
      ),
      url('/candela-procedure.webp') center 68% / cover no-repeat;
  }
  /* Временная заглушка до получения фото аппарата DEKA Motus AX.
     Когда фото появится — заменить на url(), как у остальных карточек. */
  .eq-photo--motus {
    background:
      linear-gradient(
        to top,
        rgba(13, 35, 51, 0.85) 0%,
        rgba(13, 35, 51, 0.55) 60%,
        rgba(13, 35, 51, 0.4) 100%
      ),
      linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 55%, #9adcec 100%);
  }

  .eq-photo--diode {
    background:
      linear-gradient(
        to top,
        rgba(13, 35, 51, 0.65) 0%,
        rgba(13, 35, 51, 0.1) 50%,
        transparent 100%
      ),
      url('/inmotion-procedure.webp') center 40% / cover no-repeat;
  }

  .eq-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    padding: 0.3rem 0.875rem;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .eq-photo-title {
    position: relative;
    z-index: 1;
  }
  .eq-type {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.375rem;
  }
  .eq-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .eq-wave {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }
  .eq-wave strong {
    color: var(--color-primary);
    font-weight: 700;
  }

  .eq-location {
    margin: 0;
    padding: 1.25rem 2rem 0;
    font-size: 0.9375rem;
    color: var(--color-text);
  }
  .eq-location-label {
    font-weight: 700;
    color: var(--color-primary);
  }

  .eq-desc-wrap {
    padding: 1.25rem 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .eq-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .eq-sections {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem 2rem 0;
  }
  @media (max-width: 480px) {
    .eq-sections {
      grid-template-columns: 1fr;
    }
  }

  .eq-section h4 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
  .eq-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .eq-section li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
  }
  .eq-section li::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.4em;
  }

  .eq-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
    padding: 1.25rem 2rem 2rem;
    border-top: 1px solid var(--color-border);
  }
  .eq-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .eq-stat strong {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }
  .eq-stat span {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* How it works */
  .tech-how {
    padding: 3.5rem 0;
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-border);
  }
  .tech-how h2 {
    margin-bottom: 2.5rem;
  }
  .how-steps {
    display: flex;
    flex-direction: column;
  }
  .how-step {
    display: flex;
    gap: 1.75rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: flex-start;
  }
  .how-step:last-child {
    border-bottom: none;
  }
  .step-number {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-border);
    line-height: 1;
    flex-shrink: 0;
    width: 56px;
    text-align: right;
    letter-spacing: -0.03em;
  }
  .step-content h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .step-content p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* FAQ */
  .tech-faq {
    padding: 3.5rem 0;
  }
  .tech-faq h2 {
    margin-bottom: 1.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1.25rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-item summary {
    padding: 1.125rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background var(--transition-fast);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: 1rem;
  }
  .faq-item[open] summary::after {
    content: '−';
  }
  .faq-item summary:hover {
    background: var(--color-bg-soft);
  }
  .faq-item p {
    padding: 0 1.5rem 1.25rem;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .link-faq {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  /* CTA */
  .tech-cta {
    padding: 3.5rem 0 4.5rem;
    background: var(--color-bg-soft);
    border-top: 1px solid var(--color-border);
  }
  .cta-box {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .cta-box {
      flex-direction: row;
