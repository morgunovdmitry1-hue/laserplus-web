---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaBreadcrumbs from '../components/seo/SchemaBreadcrumbs.astro';

const allServices = await getCollection('services');

const bikiniServices = [
  {
    id: 'bikini-klassika',
    zone: 'Классика',
    desc: 'По линии купальника — идеально для первого знакомства с лазером',
  },
  { id: 'glubokoye-bikini', zone: 'Глубокое', desc: 'Включает промежность и ягодичную складку' },
  { id: 'totalnoe-bikini', zone: 'Тотальное', desc: 'Полное удаление в интимной зоне' },
].map(({ id, zone, desc }) => {
  const svc = allServices.find((s) => s.id === id);
  return {
    id,
    zone,
    desc,
    title: svc?.data.title ?? '',
    priceAlex: svc?.data.price.single ?? 0,
    priceDiode: svc?.data.price.diode ?? 0,
    cardPriceAlex: Math.round(((svc?.data.price.single ?? 0) * 0.6) / 10) * 10,
    cardPriceDiode: Math.round(((svc?.data.price.diode ?? 0) * 0.6) / 10) * 10,
    sessions: svc?.data.sessionsRequired ?? '6–8',
  };
});

const faqItems = [
  {
    q: 'Больно ли делать лазерную эпиляцию бикини?',
    a: 'Нет. На Candela GentlePro система охлаждения DCD охлаждает кожу перед каждым импульсом, на DEKA Motus AX работает скользящая техника Moveo с сапфировым охлаждением. Большинство клиентов описывают ощущение как лёгкое пощипывание.',
  },
  {
    q: 'Сколько процедур нужно для зоны бикини?',
    a: 'Стандартный курс — 6–8 процедур с интервалом 4–6 недель. Уже после 2–3 сеансов заметно снижение роста волос.',
  },
  {
    q: 'Как подготовиться к процедуре?',
    a: 'Сбрейте волосы за 4–24 часа до сеанса. Не загорайте за 14 дней (Candela) или 3 дня (диодный). За 3 недели исключите восковую депиляцию и шугаринг.',
  },
  {
    q: 'Чем отличаются классика, глубокое и тотальное бикини?',
    a: 'Классика — линия купальника. Глубокое — классика + промежность. Тотальное — полное удаление в интимной зоне включая лобок и ягодичную складку.',
  },
];
---

<BaseLayout
  title="Лазерная эпиляция бикини в Новосибирске — цены, запись | Laser Plus"
  description="Лазерная эпиляция бикини в Новосибирске от 1 170 ₽. Классика, глубокое, тотальное. Александрит Candela GentlePro. Скидка 40% на первый визит. Медицинская лицензия."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />

  <div class="container">
    <SchemaBreadcrumbs
      items={[
        { name: 'Услуги', href: '/services/' },
        { name: 'Эпиляция бикини', href: '/bikini/' },
      ]}
    />
  </div>

  <!-- Hero -->
  <section class="bikini-hero">
    <div class="container">
      <p class="section-label" data-reveal>Интимные зоны</p>
      <h1 data-reveal data-reveal-delay="1">
        Лазерная эпиляция бикини<br />
        <span class="accent">в Новосибирске</span>
      </h1>
      <p class="hero-desc" data-reveal data-reveal-delay="2">
        Три вида зоны бикини на выбор — от классики до тотального. Александритовые лазеры Candela
        GentlePro и DEKA Motus AX, GentlePro с системой охлаждения: деликатно и безболезненно.
        Медицинская лицензия.
      </p>
      <div class="hero-badges" data-reveal data-reveal-delay="3">
        <span class="badge">Скидка 40% на первый визит</span>
        <span class="badge">Без боли — система DCD</span>
        <span class="badge">Медицинская лицензия</span>
      </div>
    </div>
  </section>

  <!-- Zones -->
  <section class="zones-section">
    <div class="container">
      <div class="zones-grid">
        {
          bikiniServices.map((svc, i) => (
            <a
              href={`/services/${svc.id}/`}
              class="zone-card"
              data-reveal
              data-reveal-delay={String(i + 1)}
            >
              <div class="zone-header">
                <span class="zone-num">0{i + 1}</span>
                <h2 class="zone-title">{svc.zone}</h2>
              </div>
              <p class="zone-desc">{svc.desc}</p>
              <div class="zone-prices">
                <div class="zone-laser">
                  <span class="laser-name">Александрит</span>
                  <div class="price-row-z">
                    <span class="price-card">
                      {svc.cardPriceAlex.toLocaleString('ru-RU')} ₽ по карте
                    </span>
                  </div>
                </div>
                <div class="zone-laser">
                  <span class="laser-name">Диодный</span>
                  <div class="price-row-z">
                    <span class="price-card">
                      {svc.cardPriceDiode.toLocaleString('ru-RU')} ₽ по карте
                    </span>
                  </div>
                </div>
              </div>
              <div class="zone-footer">
                <span class="zone-sessions">Курс {svc.sessions} процедур</span>
                <span class="zone-arrow" aria-hidden="true">
                  →
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="zones-cta" data-reveal>
        <div>
          <p class="zones-cta-title">Первый визит со скидкой 40%</p>
          <p class="zones-cta-sub">Бесплатная консультация перед процедурой — без обязательств</p>
        </div>
        <a href="/booking/" class="btn-cta">Записаться онлайн</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <h2 data-reveal>Частые вопросы</h2>
      <div class="faq-list" data-reveal data-reveal-delay="1">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p class="faq-answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .bikini-hero {
    padding: 2.5rem 0 3rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
  }
  .bikini-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }
  .accent {
    color: var(--color-primary);
  }
  .hero-desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 0 1.5rem;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    background: color-mix(in srgb, var(--color-primary) 10%, white);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  /* Zones */
  .zones-section {
    padding: 3.5rem 0;
    background: var(--color-bg-soft);
  }
  .zones-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .zones-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .zone-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    transition:
      box-shadow var(--transition-base),
      border-color var(--transition-base),
      transform var(--transition-fast);
  }
  .zone-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .zone-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .zone-num {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.5;
    line-height: 1;
  }
  .zone-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .zone-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
    flex: 1;
  }
  .zone-prices {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .zone-laser {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .laser-name {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    min-width: 80px;
  }
  .price-row-z {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .price-card {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .zone-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .zone-sessions {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .zone-arrow {
    color: var(--color-primary);
    font-size: 1rem;
    transition: transform var(--transition-fast);
  }
  .zone-card:hover .zone-arrow {
    transform: translateX(4px);
  }

  /* CTA */
  .zones-cta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    background: linear-gradient(130deg, #4a9ab5 0%, #64b0c7 50%, #a8d8e8 100%);
    border-radius: var(--radius-xl);
    padding: 2rem 2.5rem;
  }
  @media (min-width: 768px) {
    .zones-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .zones-cta-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.25rem;
  }
  .zones-cta-sub {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9375rem 2.25rem;
    background: #fff;
    color: #2e7d96;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    border-radius: 100px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    color: #2e7d96;
  }

  /* FAQ */
  .faq-section {
    padding: 3.5rem 0 4.5rem;
    background: var(--color-bg);
  }
  .faq-section h2 {
    margin: 0 0 1.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-item summary {
    padding: 1.125rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: background var(--transition-fast);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .faq-item[open] summary::after {
    content: '−';
  }
  .faq-item summary:hover {
    background: var(--color-bg-soft);
  }
  .faq-answer {
    padding: 0 1.5rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }
</style>
